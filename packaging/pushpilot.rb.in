class Pushpilot < Formula
  desc "Approved Playwright coverage for outgoing Git changes"
  homepage "https://github.com/Raj-Pratik/e2e-ai"
  version "@VERSION@"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "@BASE_URL@/pushpilot-@VERSION@-darwin-arm64.tar.gz"
      sha256 "@DARWIN_ARM64_SHA256@"
    else
      url "@BASE_URL@/pushpilot-@VERSION@-darwin-x64.tar.gz"
      sha256 "@DARWIN_X64_SHA256@"
    end
  end
  on_linux do
    if Hardware::CPU.arm?
      url "@BASE_URL@/pushpilot-@VERSION@-linux-arm64.tar.gz"
      sha256 "@LINUX_ARM64_SHA256@"
    else
      url "@BASE_URL@/pushpilot-@VERSION@-linux-x64.tar.gz"
      sha256 "@LINUX_X64_SHA256@"
    end
  end
  def install
    libexec.install Dir["*"]
    (bin/"pushpilot").write <<~EOS
      #!/bin/sh
      exec "#{libexec}/pushpilot" "$@"
    EOS
  end
  test do
    assert_equal version.to_s, shell_output("#{bin}/pushpilot --version").strip
  end
end
